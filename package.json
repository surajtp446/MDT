export default function PlantsPage() {
  useSEO({
    title: 'Plants | MDT — Grain Processing Plants Installed Across Asia',
    description:
      'A gallery of MDT plant installations — paddy dryers, parboiling units and silos commissioned across Karnataka, Andhra Pradesh, Bangladesh, Sri Lanka and Nepal.',
    canonical: 'https://www.mdtindia.net/plants',
  });

  const tags = useMemo(
    () => ['All', ...Array.from(new Set(PLANTS.map((p) => p.tag)))],
    []
  );
  const [filter, setFilter] = useState('All');

  const filtered =
    filter === 'All' ? PLANTS : PLANTS.filter((p) => p.tag === filter);

  return (
    <motion.div
      variants={pageVariants}
      initial="initial"
      animate="animate"
      exit="exit"
      className="pt-28"
    >
      <section className="relative bg-brand-paper py-16 sm:py-20 overflow-hidden">
        <div className="max-w-7xl mx-auto px-5 sm:px-8">
          <span className="text-brand-gold text-xs tracking-[0.25em] uppercase">
            Installations
          </span>
          <h1 className="font-black text-5xl sm:text-7xl text-brand-ink tracking-tight mt-4 mb-5">
            Plants we&apos;ve built
          </h1>
          <p className="text-brand-muted text-lg max-w-2xl">
            Over 1000 plants commissioned and running across 8 countries — from
            rice-belt Karnataka to the processing corridors of South Asia.
          </p>
        </div>
      </section>

      <section className="bg-brand-paper pb-24">
        <div className="max-w-7xl mx-auto px-5 sm:px-8">
          {/* filter tabs */}
          <div className="flex flex-wrap gap-2 mb-10">
            {tags.map((tag) => (
              <button
                key={tag}
                type="button"
                onClick={() => setFilter(tag)}
                className={`text-sm font-medium px-4 py-2 transition-colors ${
                  filter === tag
                    ? 'bg-brand-ink text-brand-paper'
                    : 'bg-brand-mist text-brand-muted hover:text-brand-ink'
                }`}
              >
                {tag}
              </button>
            ))}
          </div>

          <motion.div layout className="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <AnimatePresence mode="popLayout">
              {filtered.map((plant) => (
                <PlantCard key={plant.title} plant={plant} />
              ))}
            </AnimatePresence>
          </motion.div>
        </div>
      </section>
    </motion.div>
  );
}
