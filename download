import { useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Phone, Mail, MapPin, MessageCircle, Check } from 'lucide-react';
import { pageVariants } from '@/data/animations';
import useSEO from '@/hooks/useSEO';

const CROPS = ['Paddy', 'Sunflower', 'Groundnut', 'Maize', 'Other'];

const initialForm = {
  name: '',
  company: '',
  phone: '',
  email: '',
  region: '',
  crop: 'Paddy',
  capacity: '',
  message: '',
};

function Field({ label, children }) {
  return (
    <label className="block">
      <span className="block text-brand-muted text-xs uppercase tracking-widest mb-2">
        {label}
      </span>
      {children}
    </label>
  );
}

const inputClass =
  'w-full bg-brand-paper border border-brand-line focus:border-brand-gold text-brand-ink text-sm px-4 py-3 outline-none transition-colors placeholder:text-brand-muted/50';

export default function ContactPage() {
  useSEO({
    title: 'Contact | MDT — Get a Grain Processing Plant Quote',
    description:
      'Contact Mysore Drier Tech (MDT), Tumkur, Karnataka. Request a quote for paddy dryers, parboiling units, silos, or a complete turnkey grain processing plant.',
    canonical: 'https://www.mdtindia.net/contact',
  });

  const [form, setForm] = useState(initialForm);
  const [sent, setSent] = useState(false);

  const update = (key) => (e) =>
    setForm((f) => ({ ...f, [key]: e.target.value }));

  const handleSubmit = () => {
    if (!form.name || !form.phone) return;
    // In production this would POST to MDT's backend / CRM.
    setSent(true);
    setForm(initialForm);
    setTimeout(() => setSent(false), 5000);
  };

  return (
    <motion.div
      variants={pageVariants}
      initial="initial"
      animate="animate"
      exit="exit"
      className="pt-28"
    >
      <section className="bg-brand-paper py-16 sm:py-20">
        <div className="max-w-7xl mx-auto px-5 sm:px-8">
          <span className="text-brand-gold text-xs tracking-[0.25em] uppercase">
            Get in touch
          </span>
          <h1 className="font-black text-5xl sm:text-7xl text-brand-ink tracking-tight mt-4 mb-5">
            Let&apos;s build your plant
          </h1>
          <p className="text-brand-muted text-lg max-w-2xl">
            Tell us your crop and throughput. Our engineering team replies with
            a layout and budgetary quote within 5 working days.
          </p>
        </div>
      </section>

      <section className="bg-brand-paper pb-24">
        <div className="max-w-7xl mx-auto px-5 sm:px-8 grid lg:grid-cols-2 gap-12 lg:gap-16">
          {/* contact details */}
          <div>
            <div className="mb-8">
              <span className="font-black text-2xl tracking-tighter text-brand-ink">
                MDT
              </span>
              <span className="text-brand-gold font-medium text-sm ml-2 tracking-[0.2em] uppercase">
                Mysore Drier Tech
              </span>
            </div>

            <ul className="space-y-7">
              <li className="flex items-start gap-4">
                <span className="w-10 h-10 flex items-center justify-center border border-brand-gold/30 bg-brand-gold/[0.06] shrink-0">
                  <MapPin size={18} className="text-brand-gold" />
                </span>
                <div className="text-brand-ink/80 text-sm leading-relaxed pt-1">
                  Plot #39, 2nd Phase, KIADB Industrial Area,
                  <br />
                  Antharasanahalli, Tumkur - 572106,
                  <br />
                  Karnataka, India
                </div>
              </li>
              <li className="flex items-start gap-4">
                <span className="w-10 h-10 flex items-center justify-center border border-brand-gold/30 bg-brand-gold/[0.06] shrink-0">
                  <Phone size={18} className="text-brand-gold" />
                </span>
                <div className="text-brand-ink/80 text-sm pt-1 space-y-1">
                  <a href="tel:+919886893467" className="block hover:text-brand-gold transition-colors">
                    +91 98868 93467
                  </a>
                  <a href="tel:+918494907766" className="block hover:text-brand-gold transition-colors">
                    +91 84949 07766
                  </a>
                </div>
              </li>
              <li className="flex items-start gap-4">
                <span className="w-10 h-10 flex items-center justify-center border border-brand-gold/30 bg-brand-gold/[0.06] shrink-0">
                  <Mail size={18} className="text-brand-gold" />
                </span>
                <div className="text-brand-ink/80 text-sm pt-1 space-y-1">
                  <a href="mailto:mdt@mdtech.in" className="block hover:text-brand-gold transition-colors">
                    mdt@mdtech.in
                  </a>
                  <a href="mailto:marketing@mdtech.in" className="block hover:text-brand-gold transition-colors">
                    marketing@mdtech.in
                  </a>
                </div>
              </li>
              <li className="flex items-start gap-4">
                <span className="w-10 h-10 flex items-center justify-center border border-brand-gold/30 bg-brand-gold/[0.06] shrink-0">
                  <MessageCircle size={18} className="text-brand-gold" />
                </span>
                <div className="text-brand-ink/80 text-sm pt-1">
                  <a
                    href="https://wa.me/918494907777"
                    target="_blank"
                    rel="noopener noreferrer"
                    className="hover:text-brand-gold transition-colors"
                  >
                    WhatsApp Quote: +91 84949 07777
                  </a>
                </div>
              </li>
            </ul>
          </div>

          {/* inquiry form */}
          <div className="bg-brand-card border border-brand-line p-7 sm:p-9">
            <h2 className="font-bold text-2xl text-brand-ink mb-6">
              Request a quote
            </h2>
            <div className="grid sm:grid-cols-2 gap-5">
              <Field label="Name *">
                <input
                  type="text"
                  value={form.name}
                  onChange={update('name')}
                  className={inputClass}
                  placeholder="Your name"
                />
              </Field>
              <Field label="Company / Mill Name">
                <input
                  type="text"
                  value={form.company}
                  onChange={update('company')}
                  className={inputClass}
                  placeholder="Company"
                />
              </Field>
              <Field label="Phone *">
                <input
                  type="tel"
                  value={form.phone}
                  onChange={update('phone')}
                  className={inputClass}
                  placeholder="+91"
                />
              </Field>
              <Field label="Email">
                <input
                  type="email"
                  value={form.email}
                  onChange={update('email')}
                  className={inputClass}
                  placeholder="you@example.com"
                />
              </Field>
              <Field label="State / Country">
                <input
                  type="text"
                  value={form.region}
                  onChange={update('region')}
                  className={inputClass}
                  placeholder="Karnataka, India"
                />
              </Field>
              <Field label="Crop Type">
                <select
                  value={form.crop}
                  onChange={update('crop')}
                  className={`${inputClass} appearance-none`}
                >
                  {CROPS.map((c) => (
                    <option key={c} value={c}>
                      {c}
                    </option>
                  ))}
                </select>
              </Field>
              <div className="sm:col-span-2">
                <Field label="Capacity Required">
                  <input
                    type="text"
                    value={form.capacity}
                    onChange={update('capacity')}
                    className={inputClass}
                    placeholder="e.g. 30 TPH paddy dryer"
                  />
                </Field>
              </div>
              <div className="sm:col-span-2">
                <Field label="Message">
                  <textarea
                    rows={4}
                    value={form.message}
                    onChange={update('message')}
                    className={`${inputClass} resize-none`}
                    placeholder="Tell us about your project"
                  />
                </Field>
              </div>
            </div>

            <button
              type="button"
              onClick={handleSubmit}
              className="mt-7 w-full bg-brand-ink hover:opacity-90 text-brand-paper font-semibold text-sm py-4 transition-opacity disabled:opacity-40"
              disabled={!form.name || !form.phone}
            >
              Send enquiry
            </button>
            <p className="text-brand-muted/80 text-xs mt-3">
              Required: name and phone. We&apos;ll reply within 5 working days.
            </p>
          </div>
        </div>
      </section>

      {/* success toast */}
      <AnimatePresence>
        {sent && (
          <motion.div
            initial={{ opacity: 0, y: 30, x: '-50%' }}
            animate={{ opacity: 1, y: 0, x: '-50%' }}
            exit={{ opacity: 0, y: 30, x: '-50%' }}
            transition={{ duration: 0.4, ease: [0.22, 1, 0.36, 1] }}
            className="fixed bottom-8 left-1/2 z-[9991] flex items-center gap-3 bg-brand-ink text-brand-paper font-semibold text-sm px-6 py-4 shadow-2xl"
            role="status"
          >
            <Check size={18} className="text-brand-goldsoft" />
            Enquiry sent — our team will be in touch shortly.
          </motion.div>
        )}
      </AnimatePresence>
    </motion.div>
  );
}
